# Environment baked into the mobile (Capacitor) static export.
#
# `scripts/use-mobile-config.js` copies this over `.env.local` for the duration of
# `npm run build:mobile`, then `scripts/restore-web-config.js` puts the real
# `.env.local` back. This guarantees the Play Store bundle never inherits a
# developer's local `.env.local` (which enables the /dev-login bypass, points at
# localhost, etc.).
#
# Only NEXT_PUBLIC_* values are useful here — they are the only ones inlined into
# a static export. The native API base URL is hard-wired in src/definitions.ts
# via isNativePlatform(); the value below is only a web fallback.
#
# Safe to commit: no secrets. Fill GOOGLE_WEB_CLIENT_ID before a real release
# (see playstore/09-pre-submission-checklist.md).

NEXT_PUBLIC_API_URL=https://melodywings-backend-781782361175.us-central1.run.app
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
NEXT_PUBLIC_CURRENT_VERSION=1.0.0

# Production Google OAuth *Web* client id (used by @capgo/capacitor-social-login).
# Replace before building the release AAB — the build script warns if left as the
# placeholder.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_PROD_WEB_OAUTH_CLIENT_ID

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-8XWDEC34H7
NEXT_PUBLIC_VIEW_DEMO_LINK=https://www.youtube.com/watch?v=1TXJVRrOGRk
NEXT_PUBLIC_VIEW_DEMO_LINK_FOR_VOLUNTEER=https://app.storylane.io/share/1s7x1nmav7fv
NEXT_PUBLIC_PAGINATION=9
