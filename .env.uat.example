# Vercel environment variables for the UAT deployment of melody-wings-frontend.
# Set these in Vercel > Project > Settings > Environment Variables, scope = **Preview**, and (to keep them off
# every other branch) restrict them to the `uat` Git branch. Production-scope variables are left untouched.
# NEXT_PUBLIC_* values are baked in at BUILD time, so change one => redeploy the uat branch.

# The UAT backend (Cloud Run service melodywings-backend-uat). Also feeds the CSP connect-src automatically.
NEXT_PUBLIC_API_URL=https://melodywings-backend-uat-781782361175.us-central1.run.app
NEXT_PUBLIC_SITE_URL=https://uat.melodywings.org

# Adds X-Robots-Tag: noindex to every response (next.config.mjs).
NEXT_PUBLIC_APP_ENV=uat

# Same Google web client id as production is fine; add https://uat.melodywings.org to that client's
# "Authorized JavaScript origins" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com

# Analytics OFF in UAT so test clicks don't pollute the real numbers: leave these unset.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_POSTHOG_API_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Feature flags: turn on only what UAT is testing (the backend's WINGTIME_ENABLED must match).
# NEXT_PUBLIC_ENABLE_WINGTIME=true

# Never set in UAT: the backend has no /dev/login route outside ENVIRONMENT=dev, so it could not work anyway.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=
