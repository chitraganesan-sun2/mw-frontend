# Vercel environment variables for the UAT deployment of melody-wings-frontend (project `mw-frontend`).
# They are scoped to Vercel's **Preview** environment AND the Git branch `uat`, so production and every other
# preview keep their own values. NEXT_PUBLIC_* values are baked in at BUILD time: after changing one, rebuild `uat`.
#
#   vercel link --yes --project mw-frontend        # once per checkout (revert the .gitignore change it makes)
#   vercel env add NEXT_PUBLIC_API_URL preview uat --value <url> --yes
#   vercel env add NEXT_PUBLIC_APP_ENV preview uat --value uat --yes
#
# Only the two variables below are set for UAT; everything else is inherited from the shared Preview values.

# The UAT backend (Cloud Run service melodywings-backend-uat). It also feeds the CSP connect-src automatically.
NEXT_PUBLIC_API_URL=https://melodywings-backend-uat-781782361175.us-central1.run.app

# Marks the build as UAT: adds `X-Robots-Tag: noindex` (next.config.mjs) and turns GA4 + PostHog off
# (src/definitions.ts), because the shared Preview values would otherwise report test traffic to the real
# analytics properties.
NEXT_PUBLIC_APP_ENV=uat

# Optional, not set today: NEXT_PUBLIC_ENABLE_WINGTIME=true (must match the backend's WINGTIME_ENABLED).
# Never set in UAT: NEXT_PUBLIC_ENABLE_DEV_LOGIN (the backend has no /dev/login route outside ENVIRONMENT=dev).
#
# Live URL: https://mw-frontend-git-uat-dev-7390s-projects.vercel.app
# Google sign-in needs that origin added to the web OAuth client's "Authorized JavaScript origins".
# Vercel Authentication must be OFF for previews, or testers are sent to a Vercel login.
